---
import type { Skill, SkillCategory } from "../../types/portfolio";
import Badge from "../ui/Badge.astro";

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;

const categoryMeta: Record<SkillCategory, { label: string; color: string }> = {
  language: { label: "Languages", color: "bg-punch" },
  framework: { label: "Frameworks", color: "bg-mint" },
  tool: { label: "Tools", color: "bg-flame" },
  other: { label: "Other", color: "bg-cobalt" },
};

const order: SkillCategory[] = ["language", "framework", "tool", "other"];
const categoryColor = (name: string) => categoryMeta[name as SkillCategory].color;

const levelColor = (level: number) =>
  level >= 4 ? "bg-flame" : level >= 3 ? "bg-acid" : "bg-mint";
---

<section id="skills" class="scroll-mt-20 border-b-4 border-ink bg-acid/20 px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center border-2 border-ink bg-acid shadow-brutal-sm">
        <span class="font-display text-lg font-black">06</span>
      </span>
      <div>
        <h2 class="font-display text-3xl font-black uppercase tracking-tight sm:text-4xl">Skills</h2>
        <p class="text-sm font-bold uppercase tracking-widest text-ink/60">The arsenal, fully racked</p>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        order.map((cat) => (
          <section class:list={["card-brutal p-6", cat === "tool" ? "tilt" : ""]}>
            <div class="mb-5 flex items-center justify-between">
              <h3 class="font-display text-xl font-black uppercase tracking-tight">
                {categoryMeta[cat].label}
              </h3>
              <span class={["grid h-9 w-9 place-items-center border-2 border-ink shadow-brutal-sm", categoryColor(cat)].join(" ")} aria-hidden="true">
                <span class="font-display text-sm font-black">{skills.filter((s) => s.category === cat).length}</span>
              </span>
            </div>
            <ul class="space-y-3">
              {skills.filter((s) => s.category === cat).map((s) => (
                <li class="flex items-center justify-between gap-3">
                  <span class="min-w-0 truncate text-sm font-bold uppercase tracking-wide">{s.name}</span>
                  {
                    s.level ? (
                      <div class="flex shrink-0 items-center gap-1 border-2 border-ink bg-paper p-1" role="img"
                        aria-label={`${s.name} proficiency ${s.level} of 5`}>
                        {[1, 2, 3, 4, 5].map((n) => (
                          <span
                           
                            class={["h-2.5 w-2.5 border border-ink", n <= s.level! ? levelColor(s.level!) : "bg-paper"].join(" ")}
                            aria-hidden="true"
                          ></span>
                        ))}
                      </div>
                    ) : (
                      <Badge color="paper">core</Badge>
                    )
                  }
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
