---
import type { EducationEntry } from "../../types/portfolio";

interface Props {
  entries: EducationEntry[];
}

const { entries } = Astro.props;

const dateFmt = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en", { year: "numeric", month: "short" });
---

<section id="education" class="border-b-4 border-ink px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center border-2 border-ink bg-cobalt shadow-brutal-sm">
        <span class="font-display text-lg font-black text-paper">03</span>
      </span>
      <div>
        <h2 class="font-display text-3xl font-black uppercase tracking-tight sm:text-4xl">Education</h2>
        <p class="text-sm font-bold uppercase tracking-widest text-ink/60">The academic noise</p>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        entries.map((e) => (
          <article class="card-brutal p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center border-2 border-ink bg-acid shadow-brutal-sm">
              <span class="font-display text-lg font-black">
                {String(new Date(e.endDate ?? e.startDate + "T00:00:00").getFullYear()).slice(2)}
              </span>
            </div>
            <span class="badge-brutal bg-lilac">{e.institution}</span>
            <h3 class="mt-3 font-display text-xl font-black uppercase tracking-tight">
              {e.degree} — {e.field}
            </h3>
            <p class="mt-2 text-sm font-bold uppercase tracking-widest text-ink/60">
              {dateFmt(e.startDate)} — {e.endDate ? dateFmt(e.endDate) : "present"}
            </p>
            <p class="mt-3 text-sm font-medium text-ink/80">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent sapien massa, convallis a pellentesque nec, egestas non nisi.
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
