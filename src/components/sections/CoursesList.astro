---
import type { Course } from "../../types/portfolio";

interface Props {
  courses: Course[];
}

const { courses } = Astro.props;

const dateFmt = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en", { year: "numeric", month: "short" });

const dotColors = ["bg-punch", "bg-mint", "bg-flame", "bg-cobalt", "bg-lilac", "bg-acid"];
---

<section id="courses" class="scroll-mt-20 border-b-4 border-ink bg-lilac/30 px-4 py-16">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center gap-3">
      <span class="grid h-10 w-10 place-items-center border-2 border-ink bg-punch shadow-brutal-sm">
        <span class="font-display text-lg font-black text-paper">04</span>
      </span>
      <div>
        <h2 class="font-display text-3xl font-black uppercase tracking-tight sm:text-4xl">Courses</h2>
        <p class="text-sm font-bold uppercase tracking-widest text-ink/60">Shown, not just said</p>
      </div>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {
        courses.map((c, i) => (
          <article class="window-chrome">
            <div class="window-bar">
              <span class="grid h-4 w-4 place-items-center rounded-full border-2 border-ink bg-flame" aria-hidden="true"></span>
              <span class="grid h-4 w-4 place-items-center rounded-full border-2 border-ink bg-acid" aria-hidden="true"></span>
              <span class="grid h-4 w-4 place-items-center rounded-full border-2 border-ink bg-mint" aria-hidden="true"></span>
              <span class="ml-3 flex-1 truncate font-display text-xs font-bold uppercase tracking-widest text-paper">
                {String(i + 1).padStart(2, "0")}_course/
              </span>
              <span class={["h-3 w-3 border-2 border-ink", dotColors[i % dotColors.length]].join(" ")} aria-hidden="true"></span>
            </div>
            <div class="flex items-start justify-between gap-4 p-4">
              <div class="min-w-0">
                <h3 class="font-display text-lg font-black uppercase leading-tight tracking-tight">{c.name}</h3>
                <p class="mt-1 text-xs font-bold uppercase tracking-widest text-flame">{c.provider}</p>
              </div>
              {
                c.url && (
                  <a
                    href={c.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${c.name} — view link`}
                    class="grid h-9 w-9 shrink-0 place-items-center border-2 border-ink bg-paper shadow-brutal-sm transition-none hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none hover:bg-acid"
                  >
                     <span aria-hidden="true" class="text-ink"><i class="ph ph-arrow-right"></i></span>
                  </a>
                )
              }
            </div>
            <div class="border-t-4 border-ink bg-paper px-4 py-2 text-xs font-bold uppercase tracking-widest text-ink/60">
              Completed {dateFmt(c.completedDate)}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
