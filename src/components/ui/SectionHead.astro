---
interface Props {
  index: string;
  title: string;
  kicker: string;
  color?: "acid" | "punch" | "mint" | "flame" | "cobalt" | "lilac";
  align?: "left" | "center";
}

const { index, title, kicker, color = "acid", align = "left" } = Astro.props;

const fills: Record<string, string> = {
  acid: "bg-acid",
  punch: "bg-punch",
  mint: "bg-mint",
  flame: "bg-flame",
  cobalt: "bg-cobalt",
  lilac: "bg-lilac",
};
---

<div class:list={["mb-8", align === "center" ? "text-center" : "text-left"]}>
  <div class:list={["flex items-center gap-3", align === "center" ? "justify-center" : ""]}>
    <span class:list={["grid h-10 w-10 place-items-center border-2 border-ink shadow-brutal-sm", fills[color]]}>
      <span class="font-display text-lg font-black">{index}</span>
    </span>
    <h2 class="font-display text-3xl font-black uppercase tracking-tight sm:text-4xl">{title}</h2>
  </div>
  <p class="mt-3 max-w-2xl text-sm font-bold uppercase tracking-widest text-ink/60">{kicker}</p>
</div>
