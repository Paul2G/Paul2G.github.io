---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProjectsGrid from "../components/sections/ProjectsGrid.astro";
import ExperienceTimeline from "../components/sections/ExperienceTimeline.astro";
import EducationList from "../components/sections/EducationList.astro";
import CertificationsList from "../components/sections/CertificationsList.astro";
import SkillsGrid from "../components/sections/SkillsGrid.astro";

import {
  getProjects,
  getExperience,
  getEducation,
  getCertifications,
  getSkills,
  getContactInfo,
  getSummary,
} from "../api/mockApi";

const projects = await getProjects();
const experience = await getExperience();
const education = await getEducation();
const certifications = await getCertifications();
const skills = await getSkills();
const contact = await getContactInfo();
const summary = await getSummary();
---

<BaseLayout>
  <Hero contact={contact} summary={summary.summary} />
  <ProjectsGrid projects={projects} />
  <ExperienceTimeline entries={experience} />
  <EducationList entries={education} />
  <CertificationsList certifications={certifications} />
  <SkillsGrid groups={skills} />
</BaseLayout>
