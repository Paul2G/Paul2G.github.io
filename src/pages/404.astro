---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — Page Not Found" description="This page wandered off the grid.">
  <section class="grid-paper relative flex flex-1 flex-col items-center justify-center overflow-hidden px-4 py-8">
    <div class="pointer-events-none absolute right-6 top-8 hidden md:block" aria-hidden="true">
      <svg width="70" height="40" viewBox="0 0 70 40">
        <path d="M0 20 L15 20 L15 0 L30 0 L30 40 L45 40 L45 10 L60 10 L60 30 L70 30" fill="none" stroke="#ff4fa3" stroke-width="6" stroke-linecap="square"/>
      </svg>
    </div>

    <div class="relative mx-auto max-w-3xl text-center">
      <div class="tilt relative mx-auto grid w-fit place-items-center">
        <div class="absolute inset-0 translate-x-3 translate-y-3 border-4 border-ink bg-mint" aria-hidden="true"></div>
        <div class="relative grid aspect-square w-52 place-items-center border-4 border-ink bg-punch text-paper sm:w-64">
          <span class="font-display text-6xl font-black uppercase tracking-tighter sm:text-8xl">404</span>
        </div>
        <span class="absolute -top-5 -right-5 grid h-12 w-12 place-items-center rotate-12 border-2 border-ink bg-acid text-ink shadow-brutal-sm" aria-hidden="true">
          <i class="ph-fill ph-star-four text-3xl"></i>
        </span>
      </div>

      <h1 class="mt-10 font-display text-4xl font-black uppercase tracking-tight sm:text-5xl">
        Lost in the grid
      </h1>
      <p class="mx-auto mt-4 max-w-md text-base font-medium text-ink/80">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={base} class="btn-brutal">
          <span aria-hidden="true"><i class="ph ph-arrow-left"></i></span> Back to home base
        </a>
        <a href={base + "#work"} class="btn-brutal btn-brutal--punch">Find the projects</a>
      </div>
    </div>
  </section>
</BaseLayout>
